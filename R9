(() => {
  // Footer year
  const yearEl = document.getElementById("year");
  if (yearEl) yearEl.textContent = new Date().getFullYear();

  // Glitch mode toggle
  let glitchOn = false;
  const setGlitch = (on) => {
    glitchOn = on;
    document.documentElement.style.setProperty("--glitch", on ? "1" : "0");
    document.querySelectorAll(".glitch").forEach(h => {
      h.style.animation = on ? "glitch 1.6s infinite" : "none";
    });
  };

  // Ambience (optional)
  const audio = document.getElementById("ambience");
  let muted = true;
  const toggleAudio = () => {
    if (!audio) return;
    muted = !muted;
    audio.muted = muted;
    if (!muted) audio.play().catch(() => {});
  };

  // Keyboard shortcuts
  window.addEventListener("keydown", (e) => {
    if (e.key.toLowerCase() === "g") setGlitch(!glitchOn);
    if (e.key.toLowerCase() === "m") toggleAudio();
  });

  // Drops page loader
  const dropsGrid = document.getElementById("dropsGrid");
  const filter = document.getElementById("filter");
  const dropCount = document.getElementById("dropCount");

  const renderDrops = (items) => {
    if (!dropsGrid) return;
    dropsGrid.innerHTML = items.map(d => `
      <article class="card">
        <h2>${escapeHtml(d.name)}</h2>
        <p>${escapeHtml(d.lore)}</p>
        <span class="card-meta">${escapeHtml(d.tag)} • ${escapeHtml(d.district)} • ${escapeHtml(d.status)}</span>
      </article>
    `).join("");
    if (dropCount) dropCount.textContent = `${items.length} TRANSMISSIONS`;
  };

  const escapeHtml = (str) =>
    String(str).replace(/[&<>"']/g, (m) => ({
      "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"
    }[m]));

  const loadDrops = async () => {
    if (!dropsGrid) return;
    try {
      const res = await fetch("drops.json", { cache: "no-store" });
      const data = await res.json();
      let current = data;

      const applyFilter = () => {
        const v = filter?.value || "ALL";
        if (v === "ALL") current = data;
        else current = data.filter(x => x.status === v);
        renderDrops(current);
      };

      if (filter) filter.addEventListener("change", applyFilter);
      applyFilter();
    } catch (err) {
      dropsGrid.innerHTML = `<div class="muted">Failed to load transmissions.</div>`;
    }
  };
  loadDrops();

  // Initiation form (demo-only)
  const form = document.getElementById("initiationForm");
  const formMsg = document.getElementById("formMsg");
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const codename = document.getElementById("codename")?.value?.trim();
      const district = document.getElementById("district")?.value;
      if (formMsg) {
        formMsg.textContent = `INITIATION COMPLETE • Welcome, ${codename || "CARRIER"} • ${district || "UNKNOWN DISTRICT"}`;
      }
      form.reset();
    });
  }
})();

